ORACLE_HOST=<INTERNAL_ORACLE_HOST>
ORACLE_PORT=<ORACLE_PORT>
ORACLE_SERVICE_NAME=<ORACLE_SERVICE_NAME>
ORACLE_SID=
ORACLE_USER=<ORACLE_READONLY_USER>
ORACLE_PASSWORD=<SET_IN_LOCAL_ENVIRONMENT>
ORACLE_CLIENT_LIB_DIR=<ORACLE_CLIENT_PATH_IF_REQUIRED>
ORACLE_DSN=

# 여러 WAS가 하나의 DB를 공유할 때만 사용 (database.engine=mysql)
ASSET_DB_ENGINE=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=<SET_IN_LOCAL_ENVIRONMENT>

# 다중 WAS 에서는 모든 WAS 가 동일한 값을 사용해야 세션이 유지된다
FLASK_SECRET_KEY=<SET_IN_LOCAL_ENVIRONMENT>
